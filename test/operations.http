###############################################################################
# "Library" OData V4 test model - functions and actions
#
# Start the server first:  dotnet run --project src/LibraryService
# Every request carries the result actually observed against .NET 10.0 with
# Microsoft.AspNetCore.OData 9.5.0.
#
# 14 functions and 14 actions, including both overload pairs. The actions
# CHANGE THE STORE; restart the server for a clean slate.
###############################################################################

@host = http://localhost:5091/odata/v4/library
@book = 11111111-1111-1111-1111-111111111111
@loan = 88888888-8888-8888-8888-888888888888

###############################################################################
# Unbound functions
###############################################################################

### 200 - {"value": 7}
GET {{host}}/TotalMediaCount()

### 200 - ["de","en"]
GET {{host}}/AllLanguages()

### 200 - collection of a complex type
GET {{host}}/StatsPerBranch()

### 200 - returns an entity of a derived type
GET {{host}}/MostReadMedium()

### 200 - composable: further query options apply to the result
GET {{host}}/NewReleases()

### 200
GET {{host}}/NewReleases()?$select=Title&$top=2

### 200 - complex parameter through a parameter alias
GET {{host}}/LoanStatistics(Period=@p)?@p={"From":"2026-01-01","To":"2026-12-31"}

### 200 - the parameter is nullable
GET {{host}}/LoanStatistics(Period=null)

###############################################################################
# The Search overload pair - same name, differing parameter count
#
# Both overloads are declared in $metadata and both URLs answer, but OData
# registers only one endpoint per function name: the second route template
# never binds, so MaxResults is read off the URL by the single action.
###############################################################################

### 200
GET {{host}}/Search(Term='Prozess')

### 200 - limited to 2
GET {{host}}/Search(Term='e',MaxResults=2)?$select=Title

###############################################################################
# Bound functions
###############################################################################

### 200 - bound to a single Medium
GET {{host}}/Media({{book}})/Library.Circulation.LoanMetrics()

### 200
GET {{host}}/Media({{book}})/Library.Circulation.AvailableCopy()

### 200 - first half of the second overload pair: bound to one Medium
GET {{host}}/Media({{book}})/Library.Circulation.AvailableCopies()

### 200 - second half: the same name bound to Collection(Medium)
GET {{host}}/Media/Library.Circulation.AvailableCopies()

### 200 - bound to the collection
GET {{host}}/Media/Library.Circulation.AvailableLanguages()

### 200 - {"value": 12.50}
GET {{host}}/Members(1)/Library.Circulation.OutstandingBalance()

### 200
GET {{host}}/Members(1)/Library.Circulation.NoticeHistory()

###############################################################################
# Unbound actions
###############################################################################

### 204
POST {{host}}/ClosureDay
Content-Type: application/json

{ "Date": "2026-12-24" }

### 200
POST {{host}}/NextInventoryNumber

### 200 - collection parameter
POST {{host}}/CleanUpKeywords
Content-Type: application/json

{ "Obsolete": ["Fragment"] }

### 200 - returns a complex type
POST {{host}}/YearEndClosing
Content-Type: application/json

{ "Year": 2026 }

### 200
POST {{host}}/RunOverdueNotices

### 201 - creates an entity and returns it
POST {{host}}/AcquireCollectorsItem
Content-Type: application/json

{ "Title": "Handschrift", "Description": "aus Nachlass" }

### 400 - required parameter missing
POST {{host}}/AcquireCollectorsItem
Content-Type: application/json

{}

### 200 - composable action result
POST {{host}}/RunStockCheck

###############################################################################
# Bound actions
###############################################################################

### 200 - creates a reservation and returns the new total
POST {{host}}/Media({{book}})/Library.Circulation.Reserve
Content-Type: application/json

{ "MemberId": 1 }

### 404 - unknown medium
POST {{host}}/Media(00000000-0000-0000-0000-000000000000)/Library.Circulation.Reserve
Content-Type: application/json

{ "MemberId": 1 }

### 200
POST {{host}}/Members(1)/Library.Circulation.RunReminders

### 204 - bound to an entity with a composite key
POST {{host}}/Copies(MediumId={{book}},InventoryNumber=2)/Library.Circulation.CheckOut
Content-Type: application/json

{ "MemberId": 1 }

### 400 - unknown member
POST {{host}}/Copies(MediumId={{book}},InventoryNumber=1)/Library.Circulation.CheckOut
Content-Type: application/json

{ "MemberId": 999 }

### 200 - returns a complex type
POST {{host}}/Copies(MediumId={{book}},InventoryNumber=1)/Library.Circulation.AssessCondition
Content-Type: application/json

{ "NewCondition": 4, "Remark": "Wasserschaden" }

### 200 - returns the updated entity
POST {{host}}/Loans({{loan}})/Library.Circulation.Renew

### 200 - bound to the collection, composable
POST {{host}}/Loans/Library.Circulation.RenewAll

### 200 - bound to the collection, primitive collection result
POST {{host}}/Loans/Library.Circulation.BulkRenew
