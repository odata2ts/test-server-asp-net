###############################################################################
# "Library" OData V4 test model - create, update, delete
#
# Start the server first:  dotnet run --project src/LibraryService
# Every request carries the result actually observed against .NET 10.0 with
# Microsoft.AspNetCore.OData 9.5.0.
#
# THESE CHANGE THE STORE. The requests below assume the freshly seeded state
# and are meant to be run top to bottom; restart the server for a clean slate
# (the database is held in memory, so a restart is a reset).
###############################################################################

@host = http://localhost:5091/odata/v4/library
@book = 11111111-1111-1111-1111-111111111111
@magazine = 44444444-4444-4444-4444-444444444444
@tradeJournal = 55555555-5555-5555-5555-555555555555
@audiobook = 22222222-2222-2222-2222-222222222222
@dvd = 66666666-6666-6666-6666-666666666666
@loan = 88888888-8888-8888-8888-888888888888
@idDocument = aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa

###############################################################################
# Entities
###############################################################################

### 201 - the payload has to name the concrete type: the Media set is declared
### as the abstract Library.Catalog.Medium
POST {{host}}/Media
Content-Type: application/json

{
  "@odata.type": "#Library.Catalog.Book",
  "Title": "Neues Buch",
  "Language": "de",
  "ISBN": "9780000000001",
  "PageCount": 100
}

### 400 - same reason, on update: without @odata.type the deserializer has no
### type to construct and hands the action a null delta. Worth knowing when
### generating a client - a PATCH builder emitting only changed properties
### produces exactly this shape.
PATCH {{host}}/Media({{book}})
Content-Type: application/json

{ "Title": "Neu" }

### 204
PATCH {{host}}/Media({{book}})
Content-Type: application/json

{ "@odata.type": "#Library.Catalog.Book", "Title": "Der Prozess (2. Aufl.)" }

### 200 - Title is "Der Prozess (2. Aufl.)"
GET {{host}}/Media({{book}})?$select=Title

### 204 - the other entity sets are declared with concrete types and take an
### untyped body
PATCH {{host}}/Members(1)
Content-Type: application/json

{ "Name": "Alice M." }

### 204 - PUT replaces the member's own state; its relationships are untouched
PUT {{host}}/Members(2)
Content-Type: application/json

{
  "Name": "Bob B.",
  "DateOfBirth": "1975-11-30",
  "ActiveSince": "2020-06-20T14:30:00Z",
  "Balance": 1.5
}

### 201 - Id is assigned by the server (max + 1), never by the database
POST {{host}}/Members
Content-Type: application/json

{
  "Name": "Carla Neu",
  "DateOfBirth": "1990-01-01",
  "ActiveSince": "2026-01-01T00:00:00Z",
  "Balance": 0
}

###############################################################################
# Composite key
###############################################################################

### 201 - POST /Copies reads the payload by hand rather than through
### Delta<Copy>: the deserializer refuses a body binding a navigation property
### backed by a referential constraint.
POST {{host}}/Copies
Content-Type: application/json

{
  "MediumId": "11111111-1111-1111-1111-111111111111",
  "InventoryNumber": 99,
  "Condition": 1,
  "IsLoanable": true,
  "Status": "Available",
  "AcquisitionDate": "2026-01-01",
  "WeightKg": 0.4,
  "Location_": "A-99"
}

### 409 - a second copy with the same composite key. Accepting it left the
### store unreadable: every keyed read of that copy then failed with
### "SingleResult must have zero or one elements".
POST {{host}}/Copies
Content-Type: application/json

{ "MediumId": "11111111-1111-1111-1111-111111111111", "InventoryNumber": 99, "Condition": 1 }

### 204 - PATCH does go through Delta<T>
PATCH {{host}}/Copies(MediumId={{book}},InventoryNumber=99)
Content-Type: application/json
If-Match: *

{ "Condition": 3 }

### 204
DELETE {{host}}/Copies(MediumId={{book}},InventoryNumber=99)
If-Match: *

###############################################################################
# Nested nav-property routes: the same resource, addressed by a different
# route than its own entity set - odata2ts's `canonicalKey` cache-key feature
# depends on both routes actually being served.
###############################################################################

### 201 - a fresh copy for the nested route below
POST {{host}}/Copies
Content-Type: application/json

{
  "MediumId": "11111111-1111-1111-1111-111111111111",
  "InventoryNumber": 96,
  "Condition": 1,
  "IsLoanable": true,
  "Status": "Available",
  "AcquisitionDate": "2026-01-01",
  "WeightKg": 0.4,
  "Location_": "A-96"
}

### 204 - patched through the medium the copy was reached from, not the
### entity set directly - shares CopiesController's own concurrency check and
### patch application, so both routes stay identical in what they accept
PATCH {{host}}/Media({{book}})/Copies(MediumId={{book}},InventoryNumber=96)
Content-Type: application/json
If-Match: *

{ "Condition": 3 }

### 200 - Condition is 3, read straight back through the entity set: the
### nested PATCH above reached the very same Copy
GET {{host}}/Copies(MediumId={{book}},InventoryNumber=96)?$select=Condition

### 204
DELETE {{host}}/Copies(MediumId={{book}},InventoryNumber=96)
If-Match: *

### 204 - patched through the publisher, not the media set directly - needs no
### @odata.type, unlike a direct /Media(id) patch: the route already narrows
### to the concrete Book
PATCH {{host}}/Publishers(1)/Books({{book}})
Content-Type: application/json

{ "AgeRating": 12 }

### 200 - AgeRating is 12, read back through the same nested route - $select
### resolves cleanly here since the route already narrows to the concrete
### Book, unlike the abstract-typed Media set directly
GET {{host}}/Publishers(1)/Books({{book}})?$select=AgeRating

### 201 - a fresh copy for the three-hop nested route below
POST {{host}}/Copies
Content-Type: application/json

{
  "MediumId": "11111111-1111-1111-1111-111111111111",
  "InventoryNumber": 97,
  "Condition": 1,
  "IsLoanable": true,
  "Status": "Available",
  "AcquisitionDate": "2026-01-01",
  "WeightKg": 0.4,
  "Location_": "A-97"
}

### 204 - patched three hops deep: publisher, then its book (Books diverging
### from its entity set Media, same as the two-hop route above), then the
### copy itself - shares CopiesController's own concurrency check and patch
### application, so all three routes to this same Copy stay identical in what
### they accept
PATCH {{host}}/Publishers(1)/Books({{book}})/Copies(MediumId={{book}},InventoryNumber=97)
Content-Type: application/json
If-Match: *

{ "Condition": 3 }

### 200 - Condition is 3, read straight back through the entity set: the
### three-hop PATCH above reached the very same Copy
GET {{host}}/Copies(MediumId={{book}},InventoryNumber=97)?$select=Condition

### 204
DELETE {{host}}/Copies(MediumId={{book}},InventoryNumber=97)
If-Match: *

###############################################################################
# Deep insert
###############################################################################

### 201 - parent and children in one request. The deserializer fills the nested
### entities into the navigation property but registers them nowhere else, so
### the controller assigns their keys explicitly - without that the child is
### reachable through Members(n)/Loans while carrying an all-zero key.
POST {{host}}/Members
Content-Type: application/json

{
  "Name": "Deep Insert",
  "ActiveSince": "2026-01-01T00:00:00Z",
  "Balance": 0,
  "Loans": [ { "LoanedAt": "2026-02-01T09:00:00Z", "DueDate": "2026-03-01" } ]
}

### 200 - the nested loan, with a real key
GET {{host}}/Members(4)/Loans

### 200 - and addressable in its own set: 2 loans now
GET {{host}}/Loans?$count=true&$select=Id

###############################################################################
# Delta payload on the collection (OData 4.01)
###############################################################################

### 200 - update, removal and upsert in one request. The response is a proper
### delta payload carrying @odata.removed and @odata.id. An entry whose key is
### unknown is treated as an upsert.
PATCH {{host}}/Members
Content-Type: application/json

{
  "@context": "{{host}}/$metadata#Members/$delta",
  "value": [
    { "Id": 1, "Name": "Alice Delta" },
    { "@removed": { "reason": "deleted" }, "Id": 3 },
    { "Id": 99, "Name": "Upsert Neu", "ActiveSince": "2026-01-01T00:00:00Z", "Balance": 0 }
  ]
}

### 200 - members 1, 2, 4 and 99; 3 is gone
GET {{host}}/Members?$select=Id,Name

### 400 - and an empty body is not a delta set: the deserializer hands the
### binding null, which is a malformed request, not a server fault
PATCH {{host}}/Members
Content-Type: application/json

{}

###############################################################################
# Binding an existing entity: @odata.bind (4.0) and {"@id"} (4.01)
#
# The bindings are read from the raw request body, not through Delta<T>: the
# deserializer turns either notation into a partial instance carrying only the
# key, and Delta.Patch writes that INTO the currently linked entity - which
# answers 204 while leaving two entities under the same key behind.
###############################################################################

### 201 - bound on create
POST {{host}}/Copies
Content-Type: application/json

{
  "MediumId": "11111111-1111-1111-1111-111111111111",
  "InventoryNumber": 98,
  "Condition": 1,
  "Location@odata.bind": "{{host}}/Branches(2)"
}

### 200 - Suburban Branch
GET {{host}}/Copies(MediumId={{book}},InventoryNumber=98)/Location

### 204 - re-pointed with the 4.01 notation
PATCH {{host}}/Copies(MediumId={{book}},InventoryNumber=98)
Content-Type: application/json
If-Match: *

{ "Location": { "@id": "{{host}}/Branches(1)" } }

### 200 - Central Library
GET {{host}}/Copies(MediumId={{book}},InventoryNumber=98)/Location

### 204 - binding to null clears the link
PATCH {{host}}/Copies(MediumId={{book}},InventoryNumber=98)
Content-Type: application/json
If-Match: *

{ "Location@odata.bind": null }

### 404 - no link any more
GET {{host}}/Copies(MediumId={{book}},InventoryNumber=98)/Location

### 204
DELETE {{host}}/Copies(MediumId={{book}},InventoryNumber=98)
If-Match: *

### 201 - a deep insert and a binding in one payload: the copy is created with
### the book, the branch it names already exists. Add() tracks the whole graph
### as Added, so the bound branch has to be swapped for the stored one first -
### without that this dies on PK_Branches with a 500.
POST {{host}}/Media
Content-Type: application/json

{
  "@odata.type": "#Library.Catalog.Book",
  "Title": "Deep Insert mit Bindung",
  "Language": "de",
  "ISBN": "9780000000098",
  "PageCount": 42,
  "Publisher@odata.bind": "{{host}}/Publishers(1)",
  "Copies": [
    {
      "InventoryNumber": 97,
      "Condition": 1,
      "Location@odata.bind": "{{host}}/Branches(2)"
    }
  ]
}

### 200 - both branches unchanged: a bound entity is linked, never written
GET {{host}}/Branches?$select=Id,Name&$orderby=Id

### 400 - a binding naming an entity that does not exist is refused here rather
### than failing on a foreign key
POST {{host}}/Media
Content-Type: application/json

{
  "@odata.type": "#Library.Catalog.Book",
  "Title": "Bindung ins Leere",
  "Language": "de",
  "ISBN": "9780000000099",
  "PageCount": 42,
  "Publisher@odata.bind": "{{host}}/Publishers(999)"
}

###############################################################################
# Loans and publishers: the create endpoints the $batch reference scenarios land on
###############################################################################

### 201 - a loan's member and copy are bound, never nested: both are existing
### entities, so there is no deep insert into Loans. The computed key is
### generated here - a value the client sent is discarded.
POST {{host}}/Loans
Content-Type: application/json

{
  "LoanedAt": "2026-02-01T10:00:00Z",
  "DueDate": "2026-02-15",
  "Member@odata.bind": "{{host}}/Members(1)",
  "Copy@odata.bind": "{{host}}/Copies(MediumId={{book}},InventoryNumber=1)"
}

### 201 - the bound navigation: the same create with the member named by the
### route instead of the payload. This is where a resolved $batch URL reference
### lands; the action is PostToLoans, the convention's write shape for a bound
### navigation.
POST {{host}}/Members(2)/Loans
Content-Type: application/json

{ "LoanedAt": "2026-02-01T10:00:00Z", "DueDate": "2026-02-15" }

### 201 - Id is the next free number, as on Members; a value the client sends is discarded
POST {{host}}/Publishers
Content-Type: application/json

{ "Name": "Rowohlt", "Country": "DE" }

###############################################################################
# The managed-property terms are declared but never enforced
#
# All four (Computed, Immutable, ComputedDefaultValue, Permissions) are emitted
# in $metadata. Delta<T> records whatever the payload set and writes it
# through; the value is neither dropped nor rejected, and the client is told
# nothing. That is the library's position, not this server's.
###############################################################################

### 204 - although Loan/LoanedAt is annotated Core.Immutable
PATCH {{host}}/Loans({{loan}})
Content-Type: application/json

{ "LoanedAt": "1999-01-01T00:00:00Z" }

### 200 - and LoanedAt really is 1999-01-01
GET {{host}}/Loans({{loan}})?$select=LoanedAt

### 204 - although Medium/PopularityScore is annotated Core.Computed
PATCH {{host}}/Media({{audiobook}})
Content-Type: application/json

{ "@odata.type": "#Library.Catalog.Audiobook", "PopularityScore": 1.0 }

### 200 - and PopularityScore really is 1.0
GET {{host}}/Media({{audiobook}})?$select=PopularityScore

###############################################################################
# Singleton
###############################################################################

### 204
PATCH {{host}}/MainBranch
Content-Type: application/json

{ "Name": "Zentralbibliothek" }

### 200
GET {{host}}/MainBranch?$select=Name

###############################################################################
# Delete, and what cascades with it
###############################################################################

### 204 - the medium's copies go with it: the reference model's cascade is
### declared on the relational side too, so the database enforces it
DELETE {{host}}/Media({{dvd}})

### 404 - the DVD's copy is gone. Over the previous in-memory store it stayed
### behind with a required Medium that no longer existed.
GET {{host}}/Copies(MediumId={{dvd}},InventoryNumber=1)

### 204 - the member's loans cascade the same way
DELETE {{host}}/Members(2)

### 404
GET {{host}}/Members(2)

### 404 - deleting twice
DELETE {{host}}/Members(2)

###############################################################################
# Optimistic concurrency
#
# Copy/Condition is annotated Core.OptimisticConcurrency and emitted as
# @odata.etag, and the controllers compare what the client sends back. The
# writes above state `If-Match: *` because they are about something else; these
# are about the precondition itself.
###############################################################################

### 201 - a copy of its own, so that rewriting its token disturbs nothing else
POST {{host}}/Copies
Content-Type: application/json

{ "MediumId": "11111111-1111-1111-1111-111111111111", "InventoryNumber": 97, "Condition": 1 }

### 428 - a write without any precondition is refused
PATCH {{host}}/Copies(MediumId={{book}},InventoryNumber=97)
Content-Type: application/json

{ "Condition": 3 }

### 412 - a token that cannot be current is refused
PATCH {{host}}/Copies(MediumId={{book}},InventoryNumber=97)
Content-Type: application/json
If-Match: W/"AAAA"

{ "Condition": 3 }

### 204 - a star matches whatever is current
PATCH {{host}}/Copies(MediumId={{book}},InventoryNumber=97)
Content-Type: application/json
If-Match: *

{ "Condition": 3 }

### 428 - a delete is a write like any other
DELETE {{host}}/Copies(MediumId={{book}},InventoryNumber=97)

### 204
DELETE {{host}}/Copies(MediumId={{book}},InventoryNumber=97)
If-Match: *

###############################################################################
# PUT, and the single-entity type cast
###############################################################################

### 204 - PUT replaces the medium's own state; its copies and links are
### untouched. The payload names the concrete type, as every payload on this
### abstract-typed set does, and the computed PopularityScore is ignored
PUT {{host}}/Media({{book}})
Content-Type: application/json

{
  "@odata.type": "#Library.Catalog.Book",
  "Title": "Der Prozess (PUT)",
  "Language": "de",
  "ISBN": "9783518188002",
  "PageCount": 320,
  "AgeRating": 16,
  "PopularityScore": 0.1
}

### 200 - the replacement is stored, PopularityScore keeps its value
GET {{host}}/Media({{book}})?$select=Title,PopularityScore

### 200 - the two copies are still there
GET {{host}}/Media({{book}})/Copies?$count=true

### 400 - and without @odata.type on the base route too: the deserializer has
### no type to construct, and the body arrives null. A malformed request is
### answered 400, never dereferenced into a 500
PUT {{host}}/Media({{book}})
Content-Type: application/json

{ "Title": "Ohne Typ" }

### 204 - the same replace through the type cast. The route already narrows
### to the concrete Book, so the payload needs no @odata.type
PUT {{host}}/Media({{book}})/Library.Catalog.Book
Content-Type: application/json

{ "Title": "Der Prozess (PUT durch Cast)", "Language": "de", "ISBN": "9783518188002", "PageCount": 320, "AgeRating": 16 }

### 200 - read back through the same route
GET {{host}}/Media({{book}})/Library.Catalog.Book?$select=Title

### 404 - PUT through a cast the entity is not of
PUT {{host}}/Media({{magazine}})/Library.Catalog.Book
Content-Type: application/json

{ "Title": "Nicht ein Buch", "PageCount": 1 }

### 404 - and PATCH through the same cast
PATCH {{host}}/Media({{magazine}})/Library.Catalog.Book
Content-Type: application/json

{ "Title": "Nicht ein Buch" }

### 404 - and DELETE through it
DELETE {{host}}/Media({{magazine}})/Library.Catalog.Book

### 200 - the magazine is still what it was: none of the refused writes reached it
GET {{host}}/Media({{magazine}})?$select=Title

### 204 - PATCH through the cast; no @odata.type either
PATCH {{host}}/Media({{book}})/Library.Catalog.Book
Content-Type: application/json

{ "PageCount": 350 }

### 200 - and PageCount is 350
GET {{host}}/Media({{book}})/Library.Catalog.Book?$select=PageCount

### 400 - PATCH through the abstract intermediate without @odata.type: the
### deserializer has no type to construct
PATCH {{host}}/Media({{book}})/Library.Catalog.PrintMedium
Content-Type: application/json

{ "ISBN": "9783518188002" }

### 204 - with @odata.type, the patch reaches the concrete entity
PATCH {{host}}/Media({{book}})/Library.Catalog.PrintMedium
Content-Type: application/json

{ "@odata.type": "#Library.Catalog.Book", "Title": "Der Prozess (Print-Medium)" }

### 400 - PUT through the abstract intermediate without @odata.type: the
### deserializer has no type to construct, and the body arrives null
PUT {{host}}/Media({{book}})/Library.Catalog.PrintMedium
Content-Type: application/json

{ "ISBN": "9783518188002" }

### 204 - with @odata.type, the replace reaches the concrete entity
PUT {{host}}/Media({{book}})/Library.Catalog.PrintMedium
Content-Type: application/json

{
  "@odata.type": "#Library.Catalog.Book",
  "Title": "Der Prozess (PUT über Zwischenstufe)",
  "Language": "de",
  "ISBN": "9783518188002",
  "PageCount": 320,
  "AgeRating": 16
}

### 200 - read back through the abstract intermediate
GET {{host}}/Media({{book}})/Library.Catalog.PrintMedium?$select=Title

### 204 - DELETE through the cast
DELETE {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook

### 404
GET {{host}}/Media({{audiobook}})

### 404 - deleting twice
DELETE {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook

### 200 - the delta payload on the cast collection: one update. @context names
### the cast, as the route did
PATCH {{host}}/Media/Library.Catalog.Book
Content-Type: application/json

{
  "@context": "{{host}}/$metadata#Media/Library.Catalog.Book/$delta",
  "value": [
    { "Id": "{{book}}", "Title": "Der Prozess (Delta)" }
  ]
}

### 200 - and Title is "Der Prozess (Delta)"
GET {{host}}/Media({{book}})/Library.Catalog.Book?$select=Title

### 200 - an entry whose key is unknown is an upsert through the cast, on the
### create's own rules: the key is server-assigned
PATCH {{host}}/Media/Library.Catalog.Book
Content-Type: application/json

{
  "@context": "{{host}}/$metadata#Media/Library.Catalog.Book/$delta",
  "value": [
    { "Title": "Delta Upsert", "Language": "de", "ISBN": "9780000000100", "PageCount": 42, "AgeRating": 0 }
  ]
}

### 200 - the set gained a row: the seed book, the two this file created,
### and the upsert
GET {{host}}/Media/Library.Catalog.Book?$count=true

### 200 - and an entry with @removed deletes through the cast
PATCH {{host}}/Media/Library.Catalog.Magazine
Content-Type: application/json

{
  "@context": "{{host}}/$metadata#Media/Library.Catalog.Magazine/$delta",
  "value": [
    { "@removed": { "reason": "deleted" }, "Id": "{{tradeJournal}}" }
  ]
}

### 404 - the trade journal is gone
GET {{host}}/Media({{tradeJournal}})

### 400 - an entry that names no concrete subtype on the abstract
### intermediate: the deserializer cannot build it, and a 400 - not a 500 -
### is the honest answer
PATCH {{host}}/Media/Library.Catalog.PrintMedium
Content-Type: application/json

{
  "@context": "{{host}}/$metadata#Media/Library.Catalog.PrintMedium/$delta",
  "value": [
    { "ISBN": "9783518188002" }
  ]
}

### 400 - an empty body is not a delta set either
PATCH {{host}}/Media/Library.Catalog.Book
Content-Type: application/json

{}
