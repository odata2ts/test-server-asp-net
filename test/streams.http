###############################################################################
# "Library" OData V4 test model - media entities and stream properties
#
# Start the server first:  dotnet run --project src/LibraryService
# Every request carries the result actually observed against .NET 10.0 with
# Microsoft.AspNetCore.OData 9.5.0.
#
# The reference model puts a stream in three deliberately different positions:
#   EBook             - a media entity inside the inheritance hierarchy
#   AudiobookChapter  - a media entity that is at the same time contained
#   Audiobook.Sample  - a stream property rather than an entity's content
#
# THESE CHANGE THE STORE; restart the server for a clean slate.
###############################################################################

@host = http://localhost:5091/odata/v4/library
@book = 11111111-1111-1111-1111-111111111111
@audiobook = 22222222-2222-2222-2222-222222222222
@ebook = 33333333-3333-3333-3333-333333333333

###############################################################################
# Media entity: EBook
###############################################################################

### 200 - "EPUB placeholder for tests", Content-Type application/epub+zip
GET {{host}}/Media({{ebook}})/$value

### 204 - the content type given on PUT is stored and returned on the next GET
PUT {{host}}/Media({{ebook}})/$value
Content-Type: application/epub+zip

neuer inhalt

### 200 - "neuer inhalt"
GET {{host}}/Media({{ebook}})/$value

### 204 - clears the content
DELETE {{host}}/Media({{ebook}})/$value

### 204 - the entity exists but has no content. NOT 404: the distinction
### matters to a client deciding whether to upload.
GET {{host}}/Media({{ebook}})/$value

### 204 - deleting twice succeeds twice. 404 says the *entity* is unknown,
### never that it currently has no content - that would contradict the 204
### above.
DELETE {{host}}/Media({{ebook}})/$value

### 204 - a medium that never had content
GET {{host}}/Media({{book}})/$value

### 404 - unknown entity
GET {{host}}/Media(00000000-0000-0000-0000-000000000000)/$value

###############################################################################
# Stream property: Audiobook.Sample
#
# Through the type cast, since Sample is declared on Audiobook.
###############################################################################

### 200 - "sample audio", Content-Type audio/mpeg
GET {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Sample

### 204
PUT {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Sample
Content-Type: audio/mpeg

neues sample

### 200 - "neues sample"
GET {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Sample

### 204 - a stream property always exists as part of its entity, so this
### answers 204 whether or not there was content (OData V4.01 Part 1,
### "Deleting a Stream Property"); 404 only for an unknown audiobook.
DELETE {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Sample

### 204
GET {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Sample

###############################################################################
# Contained media entity: AudiobookChapter
###############################################################################

### 200 - "chapter one audio"
GET {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Chapters(1)/$value

### 204
PUT {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Chapters(1)/$value
Content-Type: audio/mpeg

neues kapitel

### 200 - "neues kapitel"
GET {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Chapters(1)/$value

### 404 - unknown chapter
GET {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Chapters(99)/$value
