###############################################################################
# "Library" OData V4 test model - addressing: entity sets, keys, navigation
#
# Start the server first:  dotnet run --project src/LibraryService
# Every request carries the result actually observed against .NET 10.0 with
# Microsoft.AspNetCore.OData 9.5.0. Read-only - none of these change the store.
###############################################################################

@host = http://localhost:5091/odata/v4/library

# The fixed keys from the seed (src/LibraryService/Data/LibrarySeed.cs)
@book = 11111111-1111-1111-1111-111111111111
@audiobook = 22222222-2222-2222-2222-222222222222
@ebook = 33333333-3333-3333-3333-333333333333
@magazine = 44444444-4444-4444-4444-444444444444
@tradeJournal = 55555555-5555-5555-5555-555555555555
@dvd = 66666666-6666-6666-6666-666666666666
@collectorsItem = 77777777-7777-7777-7777-777777777777
@loan = 88888888-8888-8888-8888-888888888888
@reservation = 99999999-9999-9999-9999-999999999999
@idDocument = aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa

###############################################################################
# Entity sets
###############################################################################

### 200 - 7 media, each with its @odata.type; the set is declared as the
### abstract Library.Catalog.Medium, so every instance names its derived type.
GET {{host}}/Media

### 200 - plain count segment
GET {{host}}/Media/$count

### 200
GET {{host}}/Copies

### 200
GET {{host}}/Members

### 200
GET {{host}}/Loans

### 200
GET {{host}}/Reservations

### 200
GET {{host}}/IdDocuments

### 200 - Location serialises as GeoJSON including "crs": "EPSG:4326",
### and Amenities as the flags enum: "WheelchairAccessible, Café"
GET {{host}}/Branches

### 200
GET {{host}}/Bookmobiles

### 200
GET {{host}}/Publishers

### 200 - second schema with an entity type of the same name (Branch)
GET {{host}}/PublisherBranches

### 200 - the singleton
GET {{host}}/MainBranch

###############################################################################
# Keys
###############################################################################

### 200
GET {{host}}/Media({{book}})

### 404 - unknown key
GET {{host}}/Media(00000000-0000-0000-0000-000000000000)

### 200 - open type: the dynamic properties come through, and Edm.Untyped
### carries its runtime type - "ExtraData@odata.type": "#String"
GET {{host}}/Media({{collectorsItem}})

### 200 - composite key. The payload carries @odata.etag: Copy/Condition is
### annotated Core.OptimisticConcurrency and is a real concurrency token in EF.
GET {{host}}/Copies(MediumId={{book}},InventoryNumber=1)

### 200 - integer key
GET {{host}}/Members(1)

###############################################################################
# Type cast segments and inheritance
###############################################################################

### 200 - only the books
GET {{host}}/Media/Library.Catalog.Book

### 200
GET {{host}}/Media/Library.Catalog.Audiobook

### 200
GET {{host}}/Media/Library.Catalog.EBook

### 200
GET {{host}}/Media/Library.Catalog.CollectorsItem

###############################################################################
# Alternate key (Core.AlternateKeys on PrintMedium/ISBN)
###############################################################################

### 200 - addressable only through the type cast: ISBN is declared on
### PrintMedium while the entity set is of Medium
GET {{host}}/Media/Library.Catalog.PrintMedium(ISBN='9783518188002')

### 404 - the same key without the cast
GET {{host}}/Media(ISBN='9783518188002')

###############################################################################
# Navigation
###############################################################################

### 200 - collection-valued
GET {{host}}/Media({{book}})/Copies

### 200 - single-valued, across the schema boundary into PublisherRegistry
GET {{host}}/Media({{book}})/Library.Catalog.Book/Publisher

### 200 - from the dependent side, over the referential constraint
GET {{host}}/Copies(MediumId={{book}},InventoryNumber=1)/Medium

### 200
GET {{host}}/Copies(MediumId={{book}},InventoryNumber=1)/Location

### 200 - queried off the loans set, so $filter/$orderby still reach SQL
GET {{host}}/Members(1)/Loans

### 200
GET {{host}}/Members(1)/Loans/$count

### 200
GET {{host}}/Members(1)/Reservations

### 200 - single-valued
GET {{host}}/Members(1)/IdDocument

### 200
GET {{host}}/Loans({{loan}})/Member

### 200
GET {{host}}/Loans({{loan}})/Copy

### 200
GET {{host}}/Publishers(1)/Books

###############################################################################
# Containment
###############################################################################

### 200 - through the type cast, since Chapters is declared on Audiobook
GET {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Chapters

### 404 - without the cast
GET {{host}}/Media({{audiobook}})/Chapters

### 404 - a single contained entity by key is NOT served; only the collection
### and the chapter's stream are. See limitations.http.
GET {{host}}/Media({{audiobook}})/Library.Catalog.Audiobook/Chapters(1)
